<Window x:Class="Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Locataires" Height="550" Width="450">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu -->
            <RowDefinition Height="Auto"/>
            <!-- ComboBox locataires -->
            <RowDefinition Height="*"/>
            <!-- Formulaire -->
            <RowDefinition Height="Auto"/>
            <!-- Boutons -->
        </Grid.RowDefinitions>

        <!-- Ligne 1 : Menu Fichiers / Ajouter -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button x:Name="btnFichiers" Content="Fichiers" Width="80" Margin="0,0,10,0"/>
            <Button x:Name="btnAjouter" Content="Ajouter" Width="80"/>
        </StackPanel>

        <!-- Ligne 2 : Liste déroulante des locataires -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Liste des locataires :" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbLocataires" Width="300"/>
        </StackPanel>

        <!-- Ligne 3 : Formulaire locataire -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Client -->
                <RowDefinition Height="Auto"/>
                <!-- Prénom -->
                <RowDefinition Height="Auto"/>
                <!-- Nom -->
                <RowDefinition Height="Auto"/>
                <!-- Adresse -->
                <RowDefinition Height="Auto"/>
                <!-- Ville -->
                <RowDefinition Height="Auto"/>
                <!-- Province -->
                <RowDefinition Height="Auto"/>
                <!-- Code postal -->
                <RowDefinition Height="Auto"/>
                <!-- Téléphone -->
            </Grid.RowDefinitions>

            <Label Content="Client:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtClient" Grid.Row="0" Grid.Column="1"/>

            <Label Content="Prénom:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPrenom" Grid.Row="1" Grid.Column="1"/>

            <Label Content="Nom:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtNom" Grid.Row="2" Grid.Column="1"/>

            <Label Content="Adresse:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtAdresse" Grid.Row="3" Grid.Column="1"/>

            <Label Content="Ville:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtVille" Grid.Row="4" Grid.Column="1"/>

            <Label Content="Province:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtProvince" Grid.Row="5" Grid.Column="1"/>

            <Label Content="Code postal:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCodePostal" Grid.Row="6" Grid.Column="1"/>

            <Label Content="Téléphone:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox x:Name="txtTelephone" Grid.Row="7" Grid.Column="1"/>
        </Grid>

        <!-- Ligne 4 : Boutons Enregistrer et Supprimer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnEnregistrer" Content="Enregistrer" Width="100" Margin="0,0,10,0"/>
            <Button x:Name="btnSupprimer" Content="Supprimer" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
